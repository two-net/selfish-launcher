<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Package visibility for LauncherAppsCatalog (DESIGN §5.6). Declared
         here rather than in :app so the adapter's own on-device tests run
         with it; LauncherAppsCatalogTest checks it is enough (R-4). The
         last four resolve the default apps of the first-run Home
         (FR-HOME-07). -->
    <!-- Opens the system's uninstall confirmation (FR-GRID-06, DESIGN §5.6). -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Daily Bing wallpaper (DESIGN §5.6): metered and Data Saver state for
         AndroidOsSettings (FR-WP-06), applying the image for
         AndroidSystemWallpaper (FR-WP-01, FR-WP-05), and keeping the
         wallpaper job across reboots (FR-WP-02). INTERNET arrives with the
         feed client (#15). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
        </intent>
    </queries>

    <application>
        <!-- The launcher's only background job: the wallpaper check (AR-06). -->
        <service
            android:name=".scheduler.WallpaperJobService"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- Optional (AR-09): notifications in Events, once the user grants
             access in system settings (FR-EVT-04, DESIGN §5.5, §5.6). Only
             the system can bind it. -->
        <service
            android:name=".notifications.LauncherNotificationListener"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>

</manifest>
