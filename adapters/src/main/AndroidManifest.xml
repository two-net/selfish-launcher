<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Package visibility for LauncherAppsCatalog (DESIGN §5.6). Declared
         here rather than in :app so the adapter's own on-device tests run
         with it; LauncherAppsCatalogTest checks it is enough (R-4). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application>
        <!-- The launcher's only background job: the wallpaper check (AR-06). -->
        <service
            android:name=".scheduler.WallpaperJobService"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>

</manifest>
