<?xml version="1.0" encoding="utf-8"?>
<!-- No cleartext traffic anywhere in the app, and only the system's
     certificate authorities (IF-WP-02, DESIGN §5.2). Checked by
     ManifestRulesTest. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
