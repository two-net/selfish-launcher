<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+: only the layout and settings are backed up and transferred
     (SRS §8, DESIGN §5.3). The wallpaper cache lives in noBackupFilesDir. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="layout.json" />
        <include domain="file" path="settings.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="layout.json" />
        <include domain="file" path="settings.json" />
    </device-transfer>
</data-extraction-rules>
